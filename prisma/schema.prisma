generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  ADMIN
  PROFESOR
  ALUMNO
}

model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  nombre    String
  rol       Rol      @default(ALUMNO)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profesor  Profesor?
  alumno    Alumno?
}

model Profesor {
  id           String   @id @default(cuid())
  usuarioId    String   @unique
  dni          String   @unique
  telefono     String?
  especialidad String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  usuario        Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  clases         Clase[]
  tareas         Tarea[]
  examenes       Examen[]
  seccionesTutor Seccion[]
  asistencias    Asistencia[]
}

model AnoLectivo {
  id        String   @id @default(cuid())
  anio      Int      @unique
  activo    Boolean  @default(false)
  createdAt DateTime @default(now())
  secciones  Seccion[]
  matriculas Matricula[]
  periodos   Periodo[]
}

enum TipoPeriodo {
  BIMESTRE
  TRIMESTRE
}

model Periodo {
  id           String      @id @default(cuid())
  anoLectivoId String
  nombre       String
  tipo         TipoPeriodo @default(BIMESTRE)
  orden        Int
  fechaInicio  DateTime
  fechaFin     DateTime
  activo       Boolean     @default(false)
  createdAt    DateTime    @default(now())
  anoLectivo AnoLectivo @relation(fields: [anoLectivoId], references: [id], onDelete: Cascade)
  tareas     Tarea[]
  examenes   Examen[]

  @@unique([anoLectivoId, orden])
  @@index([anoLectivoId])
}

enum TipoNivel {
  PRIMARIA
  SECUNDARIA
}

model Nivel {
  id        String    @id @default(cuid())
  nombre    String
  tipo      TipoNivel @unique
  createdAt DateTime  @default(now())
  grados   Grado[]
  criterio CriterioEvaluacion?
}

model CriterioEvaluacion {
  id                  String   @id @default(cuid())
  nivelId             String   @unique
  pesoTareas          Int      @default(40)
  pesoExamenes        Int      @default(60)
  notaAprobatoria     Float    @default(10.5)
  usaEscalaLiteral    Boolean  @default(false)
  maxMateriasDesaprob Int      @default(0)
  updatedAt           DateTime @updatedAt
  nivel Nivel @relation(fields: [nivelId], references: [id], onDelete: Cascade)
}

model Grado {
  id               String   @id @default(cuid())
  nombre           String
  nivelId          String
  ordenSecuencia   Int      @default(0)
  gradoSiguienteId String?  @unique
  createdAt        DateTime @default(now())
  nivel          Nivel         @relation(fields: [nivelId], references: [id], onDelete: Cascade)
  gradoSiguiente Grado?        @relation("SecuenciaGrado", fields: [gradoSiguienteId], references: [id])
  gradoAnterior  Grado?        @relation("SecuenciaGrado")
  secciones      Seccion[]
  planEstudios   PlanEstudio[]

  @@unique([nivelId, nombre])
}

model Materia {
  id        String   @id @default(cuid())
  nombre    String   @unique
  area      String?
  codigo    String?  @unique
  createdAt DateTime @default(now())
  planEstudios PlanEstudio[]
}

model PlanEstudio {
  id             String   @id @default(cuid())
  gradoId        String
  materiaId      String
  horasSemanales Int      @default(0)
  orden          Int      @default(0)
  obligatoria    Boolean  @default(true)
  observaciones  String?
  createdAt      DateTime @default(now())
  grado   Grado   @relation(fields: [gradoId], references: [id], onDelete: Cascade)
  materia Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  clases  Clase[]

  @@unique([gradoId, materiaId])
  @@index([gradoId])
}

model Seccion {
  id              String   @id @default(cuid())
  nombre          String
  gradoId         String
  anoLectivoId    String
  profesorTutorId String?
  createdAt       DateTime @default(now())
  grado         Grado      @relation(fields: [gradoId], references: [id], onDelete: Cascade)
  anoLectivo    AnoLectivo @relation(fields: [anoLectivoId], references: [id], onDelete: Cascade)
  profesorTutor Profesor?  @relation(fields: [profesorTutorId], references: [id], onDelete: SetNull)
  matriculas    Matricula[]
  clases        Clase[]

  @@unique([gradoId, anoLectivoId, nombre])
  @@index([anoLectivoId])
}

enum DiaSemana {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
}

model HorarioClase {
  id         String    @id @default(cuid())
  claseId    String
  dia        DiaSemana
  horaInicio String
  horaFin    String
  salon      String?
  createdAt  DateTime  @default(now())
  clase Clase @relation(fields: [claseId], references: [id], onDelete: Cascade)

  @@index([claseId])
}

model Clase {
  id            String   @id @default(cuid())
  planEstudioId String
  seccionId     String
  profesorId    String
  horario       String?
  salon         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  planEstudio PlanEstudio    @relation(fields: [planEstudioId], references: [id], onDelete: Cascade)
  seccion     Seccion        @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  profesor    Profesor       @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  tareas      Tarea[]
  examenes    Examen[]
  asistencias Asistencia[]
  horarios    HorarioClase[]
  materiales  Material[]

  @@unique([planEstudioId, seccionId])
  @@index([seccionId])
  @@index([profesorId])
}

enum EstadoAsistencia {
  PRESENTE
  AUSENTE
  TARDANZA
  JUSTIFICADO
}

model Asistencia {
  id          String           @id @default(cuid())
  claseId     String
  alumnoId    String
  profesorId  String
  fecha       DateTime
  estado      EstadoAsistencia @default(PRESENTE)
  observacion String?
  createdAt   DateTime         @default(now())
  clase    Clase    @relation(fields: [claseId], references: [id], onDelete: Cascade)
  alumno   Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  profesor Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@unique([claseId, alumnoId, fecha])
  @@index([claseId])
  @@index([alumnoId])
  @@index([fecha])
}

enum TipoMaterial {
  ARCHIVO
  ENLACE
  TEXTO
}

model Material {
  id          String       @id @default(cuid())
  claseId     String
  titulo      String
  descripcion String?
  tipo        TipoMaterial @default(ARCHIVO)
  url         String?
  contenido   String?
  createdAt   DateTime     @default(now())
  clase Clase @relation(fields: [claseId], references: [id], onDelete: Cascade)

  @@index([claseId])
}

enum EstadoAlumno {
  ACTIVO
  EGRESADO
  RETIRADO
}

model Alumno {
  id            String       @id @default(cuid())
  usuarioId     String       @unique
  dni           String       @unique
  fechaNac      DateTime?
  anoIngreso    Int
  estado        EstadoAlumno @default(ACTIVO)
  tutorDni      String?
  tutorNombre   String?
  tutorTelefono String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  usuario          Usuario           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  matriculas       Matricula[]
  entregas         Entrega[]
  respuestasExamen RespuestaExamen[]
  asistencias      Asistencia[]

  @@index([anoIngreso])
  @@index([estado])
}

enum EstadoMatricula {
  PENDIENTE
  PAGADO
  VENCIDO
}

enum MedioPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  YAPE
  PLIN
  OTRO
}

model Matricula {
  id               String          @id @default(cuid())
  alumnoId         String
  anoLectivoId     String
  seccionId        String?
  monto            Float
  fechaVencimiento DateTime
  fechaPago        DateTime?
  medioPago        MedioPago?
  estado           EstadoMatricula @default(PENDIENTE)
  observaciones    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  alumno     Alumno     @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  anoLectivo AnoLectivo @relation(fields: [anoLectivoId], references: [id])
  seccion    Seccion?   @relation(fields: [seccionId], references: [id], onDelete: SetNull)

  @@unique([alumnoId, anoLectivoId])
  @@index([anoLectivoId])
  @@index([seccionId])
}

enum EstadoTarea {
  BORRADOR
  PUBLICADA
  CERRADA
}

model Tarea {
  id            String      @id @default(cuid())
  titulo        String
  descripcion   String?
  archivoUrl    String?
  archivoNombre String?
  fechaInicio   DateTime    @default(now())
  fechaLimite   DateTime
  estado        EstadoTarea @default(BORRADOR)
  puntaje       Float       @default(20)
  profesorId    String
  claseId       String
  periodoId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  profesor Profesor  @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  clase    Clase     @relation(fields: [claseId], references: [id], onDelete: Cascade)
  periodo  Periodo?  @relation(fields: [periodoId], references: [id], onDelete: SetNull)
  entregas Entrega[]

  @@index([claseId])
  @@index([periodoId])
  @@index([estado])
}

enum EstadoEntrega {
  PENDIENTE
  ENTREGADA
  CALIFICADA
  FUERA_DE_PLAZO
}

model Entrega {
  id            String        @id @default(cuid())
  tareaId       String
  alumnoId      String
  estado        EstadoEntrega @default(PENDIENTE)
  archivoUrl    String?
  archivoNombre String?
  nota          Float?
  comentario    String?
  fechaEntrega  DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  tarea  Tarea  @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  alumno Alumno @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@unique([tareaId, alumnoId])
}

enum TipoExamen {
  ARCHIVO
  SELECCION
}

model Examen {
  id            String     @id @default(cuid())
  titulo        String
  descripcion   String?
  archivoUrl    String?
  archivoNombre String?
  tipo          TipoExamen @default(ARCHIVO)
  fechaInicio   DateTime   @default(now())
  fechaLimite   DateTime
  duracion      Int
  salon         String?
  puntaje       Float      @default(20)
  profesorId    String
  claseId       String
  periodoId     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  profesor   Profesor          @relation(fields: [profesorId], references: [id], onDelete: Cascade)
  clase      Clase             @relation(fields: [claseId], references: [id], onDelete: Cascade)
  periodo    Periodo?          @relation(fields: [periodoId], references: [id], onDelete: SetNull)
  preguntas  Pregunta[]
  respuestas RespuestaExamen[]

  @@index([claseId])
  @@index([periodoId])
}

model Pregunta {
  id       String @id @default(cuid())
  examenId String
  texto    String
  orden    Int    @default(0)
  puntaje  Float  @default(1)
  examen     Examen              @relation(fields: [examenId], references: [id], onDelete: Cascade)
  opciones   OpcionPregunta[]
  respuestas RespuestaPregunta[]

  @@index([examenId])
}

model OpcionPregunta {
  id         String  @id @default(cuid())
  preguntaId String
  texto      String
  correcta   Boolean @default(false)
  orden      Int     @default(0)
  pregunta   Pregunta            @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  respuestas RespuestaPregunta[]

  @@index([preguntaId])
}

enum EstadoRespuestaExamen {
  PENDIENTE
  ENTREGADO
  CALIFICADO
  FUERA_DE_PLAZO
}

model RespuestaExamen {
  id            String                @id @default(cuid())
  examenId      String
  alumnoId      String
  estado        EstadoRespuestaExamen @default(PENDIENTE)
  archivoUrl    String?
  archivoNombre String?
  nota          Float?
  comentario    String?
  fechaEntrega  DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  examen              Examen              @relation(fields: [examenId], references: [id], onDelete: Cascade)
  alumno              Alumno              @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  respuestasPreguntas RespuestaPregunta[]

  @@unique([examenId, alumnoId])
}

model RespuestaPregunta {
  id                String @id @default(cuid())
  respuestaExamenId String
  preguntaId        String
  opcionId          String
  respuestaExamen RespuestaExamen @relation(fields: [respuestaExamenId], references: [id], onDelete: Cascade)
  pregunta        Pregunta        @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  opcion          OpcionPregunta  @relation(fields: [opcionId], references: [id], onDelete: Cascade)

  @@unique([respuestaExamenId, preguntaId])
  @@index([respuestaExamenId])
}